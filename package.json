{
  "name": "opencode-message-rail",
  "version": "0.2.0",
  "description": "OpenCode TUI plugin: a right-edge message rail with per-turn ticks, chevrons, a dwell-hover preview card and click-to-jump.",
  "license": "MIT",
  "author": "maxvalla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxvalla/opencode-message-rail.git"
  },
  "homepage": "https://github.com/maxvalla/opencode-message-rail#readme",
  "bugs": {
    "url": "https://github.com/maxvalla/opencode-message-rail/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "plugin",
    "rail",
    "minimap",
    "navigation",
    "scrollbar",
    "terminal"
  ],
  "engines": {
    "opencode": ">=2.3.2"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.zh.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "babel src --out-dir dist --extensions .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=browser src/geom.test.ts src/controller.test.ts",
    "prepublishOnly": "npm run typecheck && npm run test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@opentui/solid": "^0.8.4",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/plugin": "2.3.2",
    "@opentui/core": "0.8.4",
    "@types/node": "^26.0.1",
    "babel-preset-solid": "1.9.12",
    "typescript": "^6.0.3"
  }
}
